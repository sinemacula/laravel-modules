{
    $schema: "./vendor/infection/infection/resources/schema.json",
    source: {
        directories: [
            "src"
        ]
    },
    logs: {
        summary: "build/infection-full-summary.log",
        text: "build/infection-full.log"
    },
    phpUnit: {
        configDir: ".",
        customPath: "vendor/bin/phpunit"
    },
    timeout: 15,
    mutators: {
        "@default": true,
        // Equivalent mutant. Every ModulePath value is relative, so there is
        // never a leading separator for ltrim to strip; the call is defensive
        // and a no-op for all reachable inputs.
        UnwrapLtrim: {
            ignore: [
                "SineMacula\\Laravel\\Modules\\Configuration\\Modules::resolvePaths"
            ]
        },
        // Equivalent mutant. The early return only fires when the factory sits
        // directly in the factory namespace, leaving nothing to name a model
        // with, so the fall-through builds candidate names ending in a
        // namespace separator - a shape no class name can take - and resolution
        // reaches the same fallback either way.
        ReturnRemoval: {
            ignore: [
                "SineMacula\\Laravel\\Modules\\Database\\FactoryResolver::moduleModelNames"
            ]
        }
    }
}
